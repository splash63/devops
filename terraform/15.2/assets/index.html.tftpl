<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Стенд LAMP</title>
  <style>
    body { margin: 0; background: #f2f5f9; color: #16263b; font: 18px system-ui, sans-serif; }
    main { max-width: 720px; margin: 8vh auto; padding: 0 24px; }
    img { display: block; width: 100%; height: auto; border-radius: 16px; }
    a { color: #174f9c; }
  </style>
</head>
<body>
  <main>
    <h1>Стенд LAMP</h1>
    <p>Запрос обработала ВМ <code id="backend">__INSTANCE_HOSTNAME__</code></p>
    <a href="${picture_url}"><img src="${picture_url}" alt="Схема стенда LAMP" width="960" height="480"></a>
    <p><a href="${picture_url}">Открыть изображение в Object Storage</a></p>
  </main>
</body>
</html>
